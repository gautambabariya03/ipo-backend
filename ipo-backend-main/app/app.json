{
  "expo": {
    "name": "IPO",
    "slug": "ipo-gmp-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#130B23",
    "plugins": [
      "expo-notifications"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#130B23"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gautambabariya.ipogmptracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B0E3D"
      }
    },
    "extra": {
      "eas": {
        "projectId": "19b05fd8-d39a-4a70-bf4d-a5f5a3476838"
      }
    }
  }
}